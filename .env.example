PORT=3000
APP_ENV=development
DB_PROVIDER=sqlite
SQLITE_PATH=./data/loja.db
# Azure App Service (Linux) — defina como App Settings, não neste arquivo:
# APP_ENV=production
# NODE_ENV=production
# DB_PROVIDER=sqlserver
# AZURE_SQL_AUTH=managedIdentity
# AZURE_SQL_SERVER=
# AZURE_SQL_DATABASE=
# Com AZURE_SQL_AUTH=sql, AZURE_SQL_USER e AZURE_SQL_PASSWORD também são obrigatórias.
# Forneça-as somente por App Settings protegidas ou referências ao Key Vault; nunca registre seus valores aqui.
AI_ENABLED=false
# AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
